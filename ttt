cat > /home/paul/singular_dossie.sh <<'EOF'
#!/usr/bin/env bash

set -u

BASE="$HOME/pesquisa_singular_dossie"
DATA="$(date '+%Y-%m-%d_%H-%M-%S')"
ANO_INICIO=1996
ANO_FIM="$(date '+%Y')"

echo "Criando pastas em: $BASE"

mkdir -p "$BASE"
mkdir -p "$BASE/atual"
mkdir -p "$BASE/atual/html"
mkdir -p "$BASE/atual/pdf"
mkdir -p "$BASE/atual/txt"
mkdir -p "$BASE/wayback"
mkdir -p "$BASE/wayback/cdx"
mkdir -p "$BASE/wayback/html"
mkdir -p "$BASE/wayback/pdf"
mkdir -p "$BASE/wayback/txt"
mkdir -p "$BASE/links"
mkdir -p "$BASE/json"
mkdir -p "$BASE/relatorios"
mkdir -p "$BASE/logs"
mkdir -p "$BASE/scripts"
mkdir -p "$BASE/exportar_windows"

cd "$BASE" || exit 1

echo "Instalando dependências..."
sudo apt update
sudo apt install -y wget curl jq lynx ripgrep python3 python3-pip python3-venv poppler-utils zip unzip ca-certificates

echo "Criando ambiente Python..."
if [ ! -d "$BASE/.venv" ]; then
  python3 -m venv "$BASE/.venv"
fi

source "$BASE/.venv/bin/activate"

pip install --upgrade pip
pip install requests beautifulsoup4 trafilatura lxml pandas

echo "Criando lista de domínios..."
cat > "$BASE/links/dominios.txt" <<'DOMINIOS'
site.singular.com.br
singular.com.br
www.singular.com.br
DOMINIOS

echo "Criando lista de URLs iniciais..."
cat > "$BASE/links/urls_seed.txt" <<'URLS'
https://site.singular.com.br/
https://site.singular.com.br/o-singular
https://www.singular.com.br/
URLS

echo "Baixando site atual..."
wget \
  --recursive \
  --level=10 \
  --convert-links \
  --adjust-extension \
  --page-requisites \
  --no-parent \
  --wait=2 \
  --random-wait \
  --limit-rate=800k \
  --user-agent="PesquisaHistoricaSingular/1.0" \
  --execute robots=on \
  -P "$BASE/atual/html" \
  https://site.singular.com.br/ \
  > "$BASE/logs/wget_atual_$DATA.log" 2>&1 || true

echo "Baixando URLs principais..."
while read -r url; do
  [ -z "$url" ] && continue

  wget \
    --page-requisites \
    --convert-links \
    --adjust-extension \
    --wait=2 \
    --random-wait \
    --limit-rate=800k \
    --user-agent="PesquisaHistoricaSingular/1.0" \
    --execute robots=on \
    -P "$BASE/atual/html/seed" \
    "$url" \
    >> "$BASE/logs/wget_seed_$DATA.log" 2>&1 || true
done < "$BASE/links/urls_seed.txt"

echo "Extraindo links do site atual..."
find "$BASE/atual/html" -type f \( -name "*.html" -o -name "*.htm" \) -print0 \
  | xargs -0 grep -Ehoi 'href="[^"]+"' \
  | sed 's/href="//; s/"//' \
  | sort -u > "$BASE/links/links_atual.txt" || true

echo "Separando PDFs encontrados..."
grep -Ei '\.pdf($|\?)' "$BASE/links/links_atual.txt" \
  | sort -u > "$BASE/links/pdfs_atual.txt" || true

echo "Baixando PDFs atuais..."
while read -r pdfurl; do
  [ -z "$pdfurl" ] && continue

  if echo "$pdfurl" | grep -q '^http'; then
    nome="$(echo -n "$pdfurl" | sha1sum | awk '{print $1}')"
    wget \
      --wait=2 \
      --random-wait \
      --limit-rate=800k \
      --user-agent="PesquisaHistoricaSingular/1.0" \
      -O "$BASE/atual/pdf/$nome.pdf" \
      "$pdfurl" \
      >> "$BASE/logs/wget_pdfs_$DATA.log" 2>&1 || true

    echo "$nome,$pdfurl" >> "$BASE/links/pdfs_baixados.csv"
  fi
done < "$BASE/links/pdfs_atual.txt"

echo "Extraindo texto dos HTMLs atuais..."
find "$BASE/atual/html" -type f \( -name "*.html" -o -name "*.htm" \) | while read -r arq; do
  nome="$(echo -n "$arq" | sha1sum | awk '{print $1}')"
  lynx -dump -nolist "$arq" > "$BASE/atual/txt/$nome.txt" 2>/dev/null || true
done

echo "Extraindo texto dos PDFs atuais..."
find "$BASE/atual/pdf" -type f -name "*.pdf" | while read -r arq; do
  nome="$(basename "$arq" .pdf)"
  pdftotext "$arq" "$BASE/atual/txt/pdf_$nome.txt" 2>/dev/null || true
done

echo "Coletando Wayback Machine por ano..."
> "$BASE/links/wayback_urls.tsv"

while read -r dominio; do
  [ -z "$dominio" ] && continue

  echo "Domínio: $dominio"

  for ano in $(seq "$ANO_INICIO" "$ANO_FIM"); do
    echo "Ano: $ano"

    mkdir -p "$BASE/wayback/cdx/$ano"

    CDX_URL="https://web.archive.org/cdx?url=${dominio}/*&from=${ano}&to=${ano}&output=json&fl=timestamp,original,statuscode,mimetype,digest&filter=statuscode:200&collapse=digest"

    curl -L \
      --max-time 90 \
      --retry 2 \
      "$CDX_URL" \
      -o "$BASE/wayback/cdx/$ano/${dominio}.json" \
      >> "$BASE/logs/wayback_cdx_$DATA.log" 2>&1 || true

    if [ -s "$BASE/wayback/cdx/$ano/${dominio}.json" ]; then
      jq -r --arg ano "$ano" --arg dominio "$dominio" '
        .[1:][]? | [$ano, $dominio, .[0], .[1], .[3], .[4]] | @tsv
      ' "$BASE/wayback/cdx/$ano/${dominio}.json" >> "$BASE/links/wayback_urls.tsv" 2>/dev/null || true
    fi

    sleep 1
  done
done < "$BASE/links/dominios.txt"

echo "Total de URLs Wayback encontradas:"
wc -l "$BASE/links/wayback_urls.tsv" || true

echo "Baixando páginas e PDFs do Wayback..."
while IFS=$'\t' read -r ano dominio timestamp original mimetype digest; do
  [ -z "${ano:-}" ] && continue
  [ -z "${timestamp:-}" ] && continue
  [ -z "${original:-}" ] && continue

  mkdir -p "$BASE/wayback/html/$ano"
  mkdir -p "$BASE/wayback/pdf/$ano"
  mkdir -p "$BASE/wayback/txt/$ano"

  hash="$(echo -n "${timestamp}_${original}" | sha1sum | awk '{print $1}')"

  if echo "$original" | grep -Eiq '\.pdf($|\?)' || echo "$mimetype" | grep -Eiq 'pdf'; then
    saida="$BASE/wayback/pdf/$ano/$hash.pdf"
  else
    saida="$BASE/wayback/html/$ano/$hash.html"
  fi

  [ -f "$saida" ] && continue

  curl -L \
    --max-time 50 \
    --retry 2 \
    --user-agent "PesquisaHistoricaSingular/1.0" \
    "https://web.archive.org/web/${timestamp}id_/${original}" \
    -o "$saida" \
    >> "$BASE/logs/wayback_download_$DATA.log" 2>&1 || true

  echo -e "$ano\t$dominio\t$timestamp\t$original\t$mimetype\t$digest\t$saida" >> "$BASE/links/wayback_arquivos_baixados.tsv"

  sleep 1
done < "$BASE/links/wayback_urls.tsv"

echo "Extraindo texto do Wayback HTML..."
find "$BASE/wayback/html" -type f -name "*.html" | while read -r arq; do
  ano="$(basename "$(dirname "$arq")")"
  nome="$(basename "$arq" .html)"
  mkdir -p "$BASE/wayback/txt/$ano"
  lynx -dump -nolist "$arq" > "$BASE/wayback/txt/$ano/$nome.txt" 2>/dev/null || true
done

echo "Extraindo texto do Wayback PDF..."
find "$BASE/wayback/pdf" -type f -name "*.pdf" | while read -r arq; do
  ano="$(basename "$(dirname "$arq")")"
  nome="$(basename "$arq" .pdf)"
  mkdir -p "$BASE/wayback/txt/$ano"
  pdftotext "$arq" "$BASE/wayback/txt/$ano/pdf_$nome.txt" 2>/dev/null || true
done

echo "Gerando dossiê final..."
cat > "$BASE/scripts/gerar_dossie.py" <<'PY'
import os
import re
import json
import csv
from collections import defaultdict, Counter

BASE = os.path.expanduser("~/pesquisa_singular_dossie")

pastas_txt = [
    os.path.join(BASE, "atual", "txt"),
    os.path.join(BASE, "wayback", "txt"),
]

termos = [
    "1966", "1970", "1971", "1972", "1978", "1990", "1993", "2000",
    "2007", "2008", "2013", "2019",
    "Singular", "Colégio Singular", "Curso Pré-Engenharia",
    "Pré-Engenharia", "Ciências e Letras", "Liceu Monteiro Lobato",
    "Sistema Anglo", "Singular Anglo", "Santo André", "São Bernardo",
    "São Caetano", "High School", "bilíngue", "bilingue",
    "University of Missouri", "Texas Tech", "Cambridge",
    "fundação", "fundado", "história", "trajetória", "vestibular",
    "ensino fundamental", "ensino médio", "educação infantil",
    "faculdade", "parceria", "unidade"
]

corpus = []
linha_tempo = []
contador_termos = Counter()

for pasta in pastas_txt:
    if not os.path.isdir(pasta):
        continue

    for raiz, dirs, files in os.walk(pasta):
        for nome in files:
            if not nome.endswith(".txt"):
                continue

            caminho = os.path.join(raiz, nome)

            try:
                with open(caminho, "r", encoding="utf-8", errors="ignore") as f:
                    texto = f.read()
            except Exception:
                continue

            texto = re.sub(r"\s+", " ", texto).strip()

            if len(texto) < 80:
                continue

            anos = sorted(set(re.findall(r"\b(18[0-9]{2}|19[0-9]{2}|20[0-9]{2})\b", texto)))

            achados = []
            for termo in termos:
                total = len(re.findall(re.escape(termo), texto, flags=re.I))
                if total:
                    contador_termos[termo] += total
                    achados.append(termo)

            item = {
                "arquivo": caminho,
                "anos_citados": anos,
                "termos": achados,
                "tamanho": len(texto),
                "trecho": texto[:2500],
            }

            corpus.append(item)

            frases = re.split(r"(?<=[.!?])\s+", texto)

            for frase in frases:
                frase = " ".join(frase.split())
                if len(frase) < 45:
                    continue

                anos_frase = re.findall(r"\b(18[0-9]{2}|19[0-9]{2}|20[0-9]{2})\b", frase)
                if not anos_frase:
                    continue

                relevante = any(re.search(re.escape(t), frase, flags=re.I) for t in termos)

                if not relevante:
                    continue

                for ano in anos_frase:
                    linha_tempo.append({
                        "ano": int(ano),
                        "descricao": frase[:1400],
                        "arquivo": caminho
                    })

linha_tempo.sort(key=lambda x: (x["ano"], x["arquivo"]))

vistos = set()
linha_unica = []

for e in linha_tempo:
    chave = (e["ano"], e["descricao"][:250].lower())
    if chave in vistos:
        continue
    vistos.add(chave)
    linha_unica.append(e)

os.makedirs(os.path.join(BASE, "json"), exist_ok=True)
os.makedirs(os.path.join(BASE, "relatorios"), exist_ok=True)
os.makedirs(os.path.join(BASE, "exportar_windows"), exist_ok=True)

with open(os.path.join(BASE, "json", "corpus_resumo.json"), "w", encoding="utf-8") as f:
    json.dump(corpus, f, ensure_ascii=False, indent=2)

with open(os.path.join(BASE, "json", "linha_tempo.json"), "w", encoding="utf-8") as f:
    json.dump(linha_unica, f, ensure_ascii=False, indent=2)

with open(os.path.join(BASE, "relatorios", "linha_tempo.csv"), "w", encoding="utf-8", newline="") as f:
    w = csv.writer(f, delimiter=";")
    w.writerow(["ano", "descricao", "arquivo"])
    for e in linha_unica:
        w.writerow([e["ano"], e["descricao"], e["arquivo"]])

with open(os.path.join(BASE, "relatorios", "00_resumo.txt"), "w", encoding="utf-8") as f:
    f.write("RESUMO DA COLETA - SINGULAR\n")
    f.write("=" * 90 + "\n\n")
    f.write(f"Arquivos de texto úteis: {len(corpus)}\n")
    f.write(f"Eventos candidatos na linha do tempo: {len(linha_unica)}\n\n")
    f.write("Termos encontrados:\n")
    for termo, total in contador_termos.most_common():
        f.write(f"- {termo}: {total}\n")

with open(os.path.join(BASE, "relatorios", "01_linha_tempo.txt"), "w", encoding="utf-8") as f:
    f.write("LINHA DO TEMPO EXTRAIDA\n")
    f.write("=" * 90 + "\n\n")

    ano_atual = None
    for e in linha_unica:
        if e["ano"] != ano_atual:
            ano_atual = e["ano"]
            f.write("\n" + "#" * 90 + "\n")
            f.write(f"ANO: {ano_atual}\n")
            f.write("#" * 90 + "\n\n")

        f.write(f"- {e['descricao']}\n")
        f.write(f"  Fonte local: {e['arquivo']}\n\n")

with open(os.path.join(BASE, "relatorios", "02_dossie_por_arquivo.txt"), "w", encoding="utf-8") as f:
    f.write("DOSSIE POR ARQUIVO\n")
    f.write("=" * 90 + "\n\n")

    for item in corpus:
        if not item["termos"]:
            continue

        f.write("-" * 90 + "\n")
        f.write(f"Arquivo: {item['arquivo']}\n")
        f.write(f"Anos citados: {', '.join(item['anos_citados'])}\n")
        f.write(f"Termos: {', '.join(item['termos'])}\n")
        f.write(f"Tamanho: {item['tamanho']}\n\n")
        f.write(item["trecho"])
        f.write("\n\n")

with open(os.path.join(BASE, "relatorios", "03_indice_termos.txt"), "w", encoding="utf-8") as f:
    f.write("INDICE DE TERMOS\n")
    f.write("=" * 90 + "\n\n")

    for termo in termos:
        f.write("\n" + "#" * 90 + "\n")
        f.write(f"TERMO: {termo}\n")
        f.write("#" * 90 + "\n\n")

        for item in corpus:
            if termo in item["termos"]:
                f.write(f"- {item['arquivo']}\n")
                f.write(f"  Anos: {', '.join(item['anos_citados'])}\n\n")

with open(os.path.join(BASE, "relatorios", "04_DOSSIE_FINAL.txt"), "w", encoding="utf-8") as out:
    for nome in [
        "00_resumo.txt",
        "01_linha_tempo.txt",
        "02_dossie_por_arquivo.txt",
        "03_indice_termos.txt",
    ]:
        caminho = os.path.join(BASE, "relatorios", nome)
        out.write("\n\n" + "=" * 120 + "\n")
        out.write(nome + "\n")
        out.write("=" * 120 + "\n\n")

        with open(caminho, "r", encoding="utf-8", errors="ignore") as f:
            out.write(f.read())

print("Dossiê gerado.")
PY

python3 "$BASE/scripts/gerar_dossie.py"

echo "Preparando arquivos para Windows..."
cp "$BASE/relatorios/"*.txt "$BASE/exportar_windows/" 2>/dev/null || true
cp "$BASE/relatorios/"*.csv "$BASE/exportar_windows/" 2>/dev/null || true
cp "$BASE/json/"*.json "$BASE/exportar_windows/" 2>/dev/null || true
cp "$BASE/links/"*.txt "$BASE/exportar_windows/" 2>/dev/null || true
cp "$BASE/links/"*.tsv "$BASE/exportar_windows/" 2>/dev/null || true
cp "$BASE/links/"*.csv "$BASE/exportar_windows/" 2>/dev/null || true

cd "$HOME" || exit 1

zip -r "$HOME/pesquisa_singular_para_windows.zip" pesquisa_singular_dossie/exportar_windows > /dev/null 2>&1 || true

echo ""
echo "FINALIZADO."
echo ""
echo "Dossiê principal:"
echo "$BASE/relatorios/04_DOSSIE_FINAL.txt"
echo ""
echo "Linha do tempo:"
echo "$BASE/relatorios/01_linha_tempo.txt"
echo "$BASE/relatorios/linha_tempo.csv"
echo ""
echo "ZIP para Windows:"
echo "$HOME/pesquisa_singular_para_windows.zip"
echo ""
echo "Para abrir:"
echo "less $BASE/relatorios/04_DOSSIE_FINAL.txt"
echo ""
echo "Para pesquisar:"
echo "rg -i '1966|fundação|história|Singular|Anglo|Santo André|São Bernardo|São Caetano' $BASE"
EOF

dos2unix /home/paul/singular_dossie.sh 2>/dev/null || true
chmod +x /home/paul/singular_dossie.sh
bash /home/paul/singular_dossie.sh
