import os
import re
import json
from collections import defaultdict, Counter

BASE = os.path.expanduser("~/pesquisa_singular_densa")
CORPUS = os.path.join(BASE, "json", "corpus_unificado.json")

with open(CORPUS, "r", encoding="utf-8") as f:
    dados = json.load(f)

termos = [
    "1966", "1970", "1971", "1972", "1978", "1990", "1993", "2000",
    "2007", "2008", "2013", "2019",
    "Curso Pré-Engenharia", "Pré-Engenharia", "Ciências e Letras",
    "Liceu Monteiro Lobato", "Sistema Anglo", "Singular Anglo",
    "Santo André", "São Bernardo", "São Caetano",
    "High School", "bilíngue", "bilingue",
    "University of Missouri", "Texas Tech", "Cambridge",
    "fundação", "fundado", "história", "trajetória",
    "vestibular", "colégio", "educação infantil", "ensino médio",
    "ensino fundamental", "faculdade", "parceria", "unidade"
]

eventos = []
por_ano_fato = defaultdict(list)
por_origem = Counter()
termos_contador = Counter()
arquivos_relevantes = []

for item in dados:
    if item.get("erro"):
        continue

    texto = item.get("texto") or ""
    origem = item.get("origem") or ""
    arquivo = item.get("arquivo") or ""
    titulo = item.get("titulo") or ""

    por_origem[origem] += 1

    termos_encontrados = []
    for termo in termos:
        total = len(re.findall(re.escape(termo), texto, flags=re.IGNORECASE))
        if total:
            termos_contador[termo] += total
            termos_encontrados.append(termo)

    if termos_encontrados:
        arquivos_relevantes.append({
            "origem": origem,
            "arquivo": arquivo,
            "titulo": titulo,
            "termos": termos_encontrados,
            "anos": item.get("anos_citados", []),
            "duplicado_aproximado": item.get("duplicado_aproximado", False),
            "trecho": texto[:1800]
        })

    frases = re.split(r"(?<=[.!?])\s+", texto)

    for frase in frases:
        frase = " ".join(frase.split())
        if len(frase) < 45:
            continue

        anos = re.findall(r"\b(18[0-9]{2}|19[0-9]{2}|20[0-9]{2})\b", frase)

        if not anos:
            continue

        relevante = False
        for termo in termos:
            if re.search(re.escape(termo), frase, flags=re.IGNORECASE):
                relevante = True
                break

        if not relevante:
            continue

        for ano in anos:
            registro = {
                "ano": int(ano),
                "descricao": frase[:1400],
                "origem": origem,
                "arquivo": arquivo,
                "titulo": titulo
            }
            eventos.append(registro)
            por_ano_fato[int(ano)].append(registro)

eventos.sort(key=lambda x: (x["ano"], x["origem"], x["arquivo"]))

# Remove duplicatas de descrição muito próximas
eventos_unicos = []
vistas = set()

for e in eventos:
    chave = (e["ano"], e["descricao"][:250].lower())
    if chave in vistas:
        continue
    vistas.add(chave)
    eventos_unicos.append(e)

rel = os.path.join(BASE, "relatorios")
js = os.path.join(BASE, "json")
os.makedirs(rel, exist_ok=True)
os.makedirs(js, exist_ok=True)

with open(os.path.join(js, "linha_tempo_densa.json"), "w", encoding="utf-8") as f:
    json.dump(eventos_unicos, f, ensure_ascii=False, indent=2)

with open(os.path.join(js, "arquivos_relevantes.json"), "w", encoding="utf-8") as f:
    json.dump(arquivos_relevantes, f, ensure_ascii=False, indent=2)

with open(os.path.join(rel, "00_resumo_coleta.txt"), "w", encoding="utf-8") as f:
    f.write("RESUMO DA COLETA DENSA - SINGULAR\n")
    f.write("=" * 100 + "\n\n")
    f.write(f"Total de itens no corpus: {len(dados)}\n")
    f.write(f"Total de eventos candidatos na linha do tempo: {len(eventos_unicos)}\n\n")

    f.write("Itens por origem:\n")
    for origem, total in por_origem.most_common():
        f.write(f"- {origem}: {total}\n")

    f.write("\nTermos mais encontrados:\n")
    for termo, total in termos_contador.most_common():
        f.write(f"- {termo}: {total}\n")

with open(os.path.join(rel, "01_linha_tempo_densa.txt"), "w", encoding="utf-8") as f:
    f.write("LINHA DO TEMPO DENSA - EXTRAIDA DE FONTES PUBLICAS\n")
    f.write("=" * 100 + "\n\n")

    ano_atual = None

    for e in eventos_unicos:
        if e["ano"] != ano_atual:
            ano_atual = e["ano"]
            f.write("\n" + "#" * 100 + "\n")
            f.write(f"ANO: {ano_atual}\n")
            f.write("#" * 100 + "\n\n")

