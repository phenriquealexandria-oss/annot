import os
import re
import json
import glob
from bs4 import BeautifulSoup
import trafilatura

BASE = os.path.expanduser("~/pesquisa_singular_densa")

fontes = []

def add_htmls(padrao, origem):
    for arq in glob.glob(padrao, recursive=True):
        fontes.append((arq, origem, "html"))

def add_txts(padrao, origem):
    for arq in glob.glob(padrao, recursive=True):
        fontes.append((arq, origem, "txt"))

add_htmls(os.path.join(BASE, "atual", "html", "**", "*.html"), "site_atual")
add_htmls(os.path.join(BASE, "atual", "html", "**", "*.htm"), "site_atual")
add_htmls(os.path.join(BASE, "wayback", "html", "**", "*.html"), "wayback")
add_txts(os.path.join(BASE, "atual", "txt", "**", "*.txt"), "texto_atual")
add_txts(os.path.join(BASE, "wayback", "txt", "**", "*.txt"), "texto_wayback")
add_txts(os.path.join(BASE, "commoncrawl", "txt", "**", "*.txt"), "commoncrawl")

resultados = []
vistos_hash_texto = set()

for arq, origem, tipo in fontes:
    try:
        if tipo == "html":
            with open(arq, "r", encoding="utf-8", errors="ignore") as f:
                html = f.read()

            soup = BeautifulSoup(html, "lxml")
            titulo = soup.title.get_text(" ", strip=True) if soup.title else ""
            texto = trafilatura.extract(html) or soup.get_text(" ", strip=True)

        else:
            with open(arq, "r", encoding="utf-8", errors="ignore") as f:
                texto = f.read()
            titulo = ""

        texto = re.sub(r"\s+", " ", texto or "").strip()

        if len(texto) < 80:
            continue

        texto_key = hash(texto[:5000])
        duplicado = texto_key in vistos_hash_texto
        vistos_hash_texto.add(texto_key)

        anos = sorted(set(re.findall(r"\b(18[0-9]{2}|19[0-9]{2}|20[0-9]{2})\b", texto)))

        resultados.append({
            "arquivo": arq,
            "origem": origem,
            "tipo": tipo,
            "titulo": titulo,
            "duplicado_aproximado": duplicado,
            "anos_citados": anos,
            "tamanho_texto": len(texto),
            "texto": texto
        })

    except Exception as e:
        resultados.append({
            "arquivo": arq,
            "origem": origem,
            "erro": str(e)
        })

saida_json = os.path.join(BASE, "json", "corpus_unificado.json")
saida_txt = os.path.join(BASE, "relatorios", "corpus_unificado.txt")

with open(saida_json, "w", encoding="utf-8") as f:
    json.dump(resultados, f, ensure_ascii=False, indent=2)

with open(saida_txt, "w", encoding="utf-8") as f:
    for item in resultados:
        if item.get("erro"):
            continue

        f.write("=" * 120 + "\n")
        f.write(f"ORIGEM: {item.get('origem')}\n")
        f.write(f"ARQUIVO: {item.get('arquivo')}\n")
        f.write(f"TÍTULO: {item.get('titulo','')}\n")
        f.write(f"DUPLICADO APROXIMADO: {item.get('duplicado_aproximado')}\n")
        f.write(f"ANOS CITADOS: {', '.join(item.get('anos_citados', []))}\n")
        f.write(f"TAMANHO: {item.get('tamanho_texto')}\n\n")
        f.write(item.get("texto", ""))
        f.write("\n\n")

print(f"Corpus JSON: {saida_json}")
print(f"Corpus TXT: {saida_txt}")
print(f"Total itens: {len(resultados)}")
