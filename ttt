#!/usr/bin/env bash

set -e

BASE="$HOME/pesquisa_singular_densa"
DATA="$(date '+%Y-%m-%d_%H-%M-%S')"

# Ajustes principais
ANO_INICIO=1996
ANO_FIM="$(date '+%Y')"

# 0 = sem limite por ano.
# Se ficar pesado demais, mude para 500, 1000, 2000 etc.
LIMIT_POR_ANO=0

# 1 = baixa imagens públicas encontradas; 0 = apenas cataloga imagens.
# Recomendo deixar 0 para não ficar enorme.
BAIXAR_IMAGENS=0

# 1 = usa collapse=digest no Wayback para não baixar cópias idênticas.
# 0 = tenta baixar tudo mesmo que repetido, pode ficar gigante.
USAR_DEDUPE_WAYBACK=1

mkdir -p "$BASE"/{
  atual/html,
  atual/pdf,
  atual/txt,
  atual/sitemaps,
  wayback/cdx,
  wayback/html,
  wayback/pdf,
  wayback/txt,
  commoncrawl/index,
  commoncrawl/html,
  commoncrawl/txt,
  imagens/listas,
  imagens/arquivos,
  links,
  json,
  relatorios,
  logs,
  scripts,
  exportar_windows
}

cd "$BASE"

echo "============================================================"
echo "PESQUISA SINGULAR - MODO DENSO"
echo "Base: $BASE"
echo "Data: $DATA"
echo "============================================================"

echo "== Instalando dependências =="
sudo apt update
sudo apt install -y \
  wget \
  curl \
  jq \
  lynx \
  ripgrep \
  python3 \
  python3-pip \
  python3-venv \
  poppler-utils \
  zip \
  unzip \
  git \
  ca-certificates \
  coreutils \
  sed \
  gawk \
  grep

echo "== Criando ambiente Python =="
if [ ! -d ".venv" ]; then
  python3 -m venv .venv
fi

source .venv/bin/activate
pip install --upgrade pip
pip install \
  requests \
  beautifulsoup4 \
  trafilatura \
  lxml \
  pandas \
  tqdm

echo "== Domínios e URLs iniciais =="

cat > links/dominios.txt <<'EOF'
site.singular.com.br
singular.com.br
www.singular.com.br
EOF

cat > links/urls_seed.txt <<'EOF'
https://site.singular.com.br/
https://site.singular.com.br/o-singular
https://www.singular.com.br/
EOF

cat > links/termos_busca_manual.txt <<'EOF'
"Colégio Singular" "1966"
"Curso Pré-Engenharia Singular"
"Colégio Singular" história
"Colégio Singular" "50 anos"
"Colégio Singular" "55 anos"
"Colégio Singular" "60 anos"
"Singular Anglo"
"Singular" "Liceu Monteiro Lobato"
"Singular" "Ciências e Letras Vestibulares"
"Colégio Singular" "Santo André"
"Colégio Singular" "São Bernardo"
"Colégio Singular" "São Caetano"
"Paolo Gambogi" Singular
"Paulo Roberto De Francisco" Singular
"Singular" "University of Missouri"
"Singular" "Texas Tech"
"Singular" "Cambridge"
site:site.singular.com.br Singular
site:singular.com.br Singular
filetype:pdf "Colégio Singular"
filetype:pdf "Singular Anglo"
EOF

echo "== Baixando robots.txt e sitemaps conhecidos =="

while read -r dominio; do
  [ -z "$dominio" ] && continue

  mkdir -p "atual/sitemaps/$dominio"

  curl -L --max-time 30 "https://$dominio/robots.txt" \
    -o "atual/sitemaps/$dominio/robots.txt" || true

  curl -L --max-time 30 "https://$dominio/sitemap.xml" \
    -o "atual/sitemaps/$dominio/sitemap.xml" || true

  curl -L --max-time 30 "https://$dominio/sitemap_index.xml" \
    -o "atual/sitemaps/$dominio/sitemap_index.xml" || true

  sleep 1
done < links/dominios.txt

echo "== Extraindo URLs de sitemaps =="

cat > scripts/extrair_sitemaps.py <<'PY'
import os
import re
import glob
from bs4 import BeautifulSoup

BASE = os.path.expanduser("~/pesquisa_singular_densa")
saida = os.path.join(BASE, "links", "urls_sitemaps.txt")
arquivos = glob.glob(os.path.join(BASE, "atual", "sitemaps", "**", "*.xml"), recursive=True)

urls = set()

for arq in arquivos:
    try:
        with open(arq, "r", encoding="utf-8", errors="ignore") as f:
            conteudo = f.read()

        soup = BeautifulSoup(conteudo, "xml")

        for loc in soup.find_all("loc"):
            url = loc.get_text(strip=True)
            if url:
                urls.add(url)

        for url in re.findall(r"https?://[^\s<>'\"]+", conteudo):
            urls.add(url.strip())

    except Exception:
        pass

with open(saida, "w", encoding="utf-8") as f:
    for url in sorted(urls):
        f.write(url + "\n")

print(f"URLs de sitemap: {len(urls)}")
PY

python scripts/extrair_sitemaps.py

echo "== Juntando URLs iniciais =="
cat links/urls_seed.txt links/urls_sitemaps.txt 2>/dev/null \
  | sort -u > links/urls_iniciais_todas.txt

echo "== Baixando site atual de forma recursiva =="

wget \
  --recursive \
  --level=10 \
  --convert-links \
  --adjust-extension \
  --page-requisites \
  --no-parent \
  --wait=2 \
  --random-wait \
  --limit-rate=800k \
  --user-agent="PesquisaHistoricaSingularDensa/1.0" \
  --execute robots=on \
  -P atual/html \
  https://site.singular.com.br/ \
  2>&1 | tee "logs/wget_atual_site_$DATA.log" || true

echo "== Baixando URLs de seed e sitemap =="

while read -r url; do
  [ -z "$url" ] && continue

  echo "URL atual: $url"

  wget \
    --page-requisites \
    --convert-links \
    --adjust-extension \
    --wait=2 \
    --random-wait \
    --limit-rate=800k \
    --user-agent="PesquisaHistoricaSingularDensa/1.0" \
