import os
import json
import time
import gzip
import requests
from urllib.parse import quote

BASE = os.path.expanduser("~/pesquisa_singular_densa")
DOMINIOS = os.path.join(BASE, "links", "dominios.txt")
INDEX_DIR = os.path.join(BASE, "commoncrawl", "index")
HTML_DIR = os.path.join(BASE, "commoncrawl", "html")
LOG = os.path.join(BASE, "logs", "commoncrawl.log")

os.makedirs(INDEX_DIR, exist_ok=True)
os.makedirs(HTML_DIR, exist_ok=True)

session = requests.Session()
session.headers.update({"User-Agent": "PesquisaHistoricaSingularDensa/1.0"})

def log(msg):
    print(msg)
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(msg + "\n")

try:
    collinfo = session.get("https://index.commoncrawl.org/collinfo.json", timeout=60).json()
except Exception as e:
    log(f"Erro ao obter collinfo: {e}")
    raise SystemExit

# Pega índices mais recentes e alguns antigos.
# Se quiser ainda mais, remova o [:12].
indexes = [c["id"] for c in collinfo]
indexes = indexes[:12]

with open(DOMINIOS, "r", encoding="utf-8") as f:
    dominios = [x.strip() for x in f if x.strip()]

all_records_path = os.path.join(BASE, "links", "commoncrawl_registros.jsonl")

with open(all_records_path, "w", encoding="utf-8") as allout:
    for index in indexes:
        for dominio in dominios:
            url = f"https://index.commoncrawl.org/{index}-index?url={quote(dominio + '/*')}&output=json&filter=status:200"

            log(f"Consultando {index} - {dominio}")

            try:
                r = session.get(url, timeout=90)
                if r.status_code != 200:
                    log(f"  status {r.status_code}")
                    continue

                linhas = [x for x in r.text.splitlines() if x.strip()]
                out_path = os.path.join(INDEX_DIR, f"{index}_{dominio}.jsonl")

                with open(out_path, "w", encoding="utf-8") as f:
                    for linha in linhas:
                        f.write(linha + "\n")
                        allout.write(linha + "\n")

                log(f"  registros: {len(linhas)}")

            except Exception as e:
                log(f"  erro: {e}")

            time.sleep(1)

print(f"Registros Common Crawl em: {all_records_path}")
PY

