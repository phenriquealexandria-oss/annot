    2>> "logs/wget_atual_urls_$DATA.log" || true

done < links/urls_iniciais_todas.txt

echo "== Extraindo todos os links do material atual =="

find atual/html -type f \( -name "*.html" -o -name "*.htm" \) -print0 \
  | xargs -0 grep -Ehoi 'href="[^"]+"' \
  | sed 's/href="//; s/"//' \
  | sort -u > links/links_extraidos_atual.txt || true

grep -Eio 'https?://[^ ]+' links/links_extraidos_atual.txt \
  | sort -u > links/urls_absolutas_extraidas_atual.txt || true

grep -Ei '\.pdf($|\?)' links/links_extraidos_atual.txt \
  | sort -u > links/pdfs_atual.txt || true

grep -Ei '\.(jpg|jpeg|png|webp|gif)($|\?)' links/links_extraidos_atual.txt \
  | sort -u > imagens/listas/imagens_atual.txt || true

echo "== Baixando PDFs atuais =="

while read -r pdfurl; do
  [ -z "$pdfurl" ] && continue

  safe="$(echo "$pdfurl" | sha1sum | awk '{print $1}')"

  wget \
    --wait=2 \
    --random-wait \
    --limit-rate=800k \
    --user-agent="PesquisaHistoricaSingularDensa/1.0" \
    -O "atual/pdf/${safe}.pdf" \
    "$pdfurl" \
    2>> "logs/wget_pdfs_atual_$DATA.log" || true

  echo "$safe,$pdfurl" >> links/pdfs_atual_baixados.csv

done < links/pdfs_atual.txt

if [ "$BAIXAR_IMAGENS" = "1" ]; then
  echo "== Baixando imagens atuais =="

  while read -r imgurl; do
    [ -z "$imgurl" ] && continue

    safe="$(echo "$imgurl" | sha1sum | awk '{print $1}')"

    wget \
      --wait=1 \
      --random-wait \
      --limit-rate=800k \
      --user-agent="PesquisaHistoricaSingularDensa/1.0" \
      -O "imagens/arquivos/${safe}" \
      "$imgurl" \
      2>> "logs/wget_imagens_$DATA.log" || true

    echo "$safe,$imgurl" >> imagens/listas/imagens_baixadas.csv

  done < imagens/listas/imagens_atual.txt
fi

echo "== Extraindo texto do site atual =="

find atual/html -type f \( -name "*.html" -o -name "*.htm" \) | while read -r arq; do
  safe="$(echo "$arq" | sha1sum | awk '{print $1}')"
  lynx -dump -nolist "$arq" > "atual/txt/${safe}.txt" || true
  echo "$safe,$arq" >> links/html_atual_extraidos.csv
done

find atual/pdf -type f -name "*.pdf" | while read -r arq; do
  safe="$(basename "$arq" .pdf)"
  pdftotext "$arq" "atual/txt/pdf_${safe}.txt" || true
done

echo "== Wayback Machine: coletando CDX por ano e domínio =="

> links/wayback_urls_por_ano.csv

while read -r dominio; do
  [ -z "$dominio" ] && continue

  echo "Domínio Wayback: $dominio"

  for ano in $(seq "$ANO_INICIO" "$ANO_FIM"); do
    echo "  Ano: $ano"

    mkdir -p "wayback/cdx/$ano"

    if [ "$USAR_DEDUPE_WAYBACK" = "1" ]; then
      CDX_URL="https://web.archive.org/cdx?url=${dominio}/*&from=${ano}&to=${ano}&output=json&fl=timestamp,original,statuscode,mimetype,digest&filter=statuscode:200&collapse=digest"
    else
      CDX_URL="https://web.archive.org/cdx?url=${dominio}/*&from=${ano}&to=${ano}&output=json&fl=timestamp,original,statuscode,mimetype,digest&filter=statuscode:200"
    fi

    curl -L \
      --max-time 90 \
      --retry 2 \
      "$CDX_URL" \
      -o "wayback/cdx/$ano/${dominio}.json" || true

    if [ ! -s "wayback/cdx/$ano/${dominio}.json" ]; then
      sleep 1
      continue
    fi

    if [ "$LIMIT_POR_ANO" = "0" ]; then
      jq -r --arg ano "$ano" --arg dominio "$dominio" '
        .[1:][]? | [$ano, $dominio, .[0], .[1], .[3], .[4]] | @csv
      ' "wayback/cdx/$ano/${dominio}.json" >> links/wayback_urls_por_ano.csv || true
    else
      jq -r --arg ano "$ano" --arg dominio "$dominio" '
        .[1:][]? | [$ano, $dominio, .[0], .[1], .[3], .[4]] | @csv
      ' "wayback/cdx/$ano/${dominio}.json" | head -n "$LIMIT_POR_ANO" >> links/wayback_urls_por_ano.csv || true
    fi

    sleep 1
  done

done < links/dominios.txt

echo "== Total Wayback encontrado =="
wc -l links/wayback_urls_por_ano.csv || true

echo "== Baixando Wayback HTML/PDF/texto por ano =="

> links/wayback_arquivos_baixados.csv

cat links/wayback_urls_por_ano.csv | while IFS=, read -r ano dominio timestamp original mimetype digest; do
  ano="$(echo "$ano" | tr -d '"')"
  dominio="$(echo "$dominio" | tr -d '"')"
  timestamp="$(echo "$timestamp" | tr -d '"')"
  original="$(echo "$original" | sed 's/^"//; s/"$//')"
  mimetype="$(echo "$mimetype" | tr -d '"')"
  digest="$(echo "$digest" | tr -d '"')"

  [ -z "$ano" ] && continue
  [ -z "$timestamp" ] && continue
  [ -z "$original" ] && continue

  mkdir -p "wayback/html/$ano" "wayback/pdf/$ano" "wayback/txt/$ano"

  hash="$(echo -n "${timestamp}_${original}" | sha1sum | awk '{print $1}')"

  if echo "$original" | grep -Eiq '\.pdf($|\?)' || echo "$mimetype" | grep -Eiq 'pdf'; then
    saida="wayback/pdf/$ano/${hash}.pdf"
  else
    saida="wayback/html/$ano/${hash}.html"
  fi

  if [ -f "$saida" ]; then
    continue
  fi

  echo "Wayback $ano: $original"

  curl -L \
    --max-time 50 \
    --retry 2 \
    --user-agent "PesquisaHistoricaSingularDensa/1.0" \
    "https://web.archive.org/web/${timestamp}id_/${original}" \
    -o "$saida" || true

  echo "$ano,$dominio,$timestamp,$original,$mimetype,$digest,$saida" >> links/wayback_arquivos_baixados.csv

  sleep 1
done

echo "== Extraindo texto do Wayback =="

find wayback/html -type f -name "*.html" | while read -r arq; do
  ano="$(echo "$arq" | awk -F/ '{print $(NF-1)}')"
  nome="$(basename "$arq" .html)"
  lynx -dump -nolist "$arq" > "wayback/txt/$ano/${nome}.txt" || true
done

find wayback/pdf -type f -name "*.pdf" | while read -r arq; do
  ano="$(echo "$arq" | awk -F/ '{print $(NF-1)}')"
  nome="$(basename "$arq" .pdf)"
  pdftotext "$arq" "wayback/txt/$ano/pdf_${nome}.txt" || true
done

